  status                    OfferStatus @default(draft)
  offered_salary_amount     Decimal?    @db.Decimal(15, 4)
  offered_salary_currency   String?     @db.VarChar(3)
  offered_total_comp_amount Decimal?    @db.Decimal(15, 4)
  joining_date              DateTime?   @db.Date
  offer_extended_at         DateTime?   @db.Timestamptz(6)
  offer_expires_at          DateTime?   @db.Timestamptz(6)
  accepted_at               DateTime?   @db.Timestamptz(6)
  declined_at               DateTime?   @db.Timestamptz(6)
  decline_reason            String?
  notes                     String?
  created_by_ref_id         String      @db.Uuid
  created_at                DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime    @updatedAt @db.Timestamptz(6)

  application Application       @relation(fields: [application_id], references: [id], onDelete: NoAction)
  created_by  IdentityReference @relation("OfferCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)
  placement   Placement?

  @@map("offers")
}

model Placement {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offer_id                String          @unique @db.Uuid
  application_id          String          @db.Uuid
  candidate_id            String          @db.Uuid
  job_id                  String          @db.Uuid
  organization_id         String          @db.Uuid
  joining_date            DateTime        @db.Date
  placed_title            String?         @db.VarChar(200)
  placed_salary_amount    Decimal?        @db.Decimal(15, 4)
  placed_salary_currency  String?         @db.VarChar(3)
  placement_credit_ref_id String?         @db.Uuid
  secondary_credit_ref_id String?         @db.Uuid
  credit_split_pct        Decimal?        @db.Decimal(5, 2)
  status                  PlacementStatus @default(active)
  guarantee_days          Int?
  guarantee_end_date      DateTime?       @db.Date
  commercial_terms_id     String?         @db.Uuid
  fee_type                FeeType?
  fee_percentage          Decimal?        @db.Decimal(5, 2)
  calculated_fee_amount   Decimal?        @db.Decimal(15, 4)
  gst_rate                Decimal?        @db.Decimal(5, 2)
  gst_amount              Decimal?        @db.Decimal(15, 4)
  invoice_amount          Decimal?        @db.Decimal(15, 4)
  fee_currency            String?         @db.VarChar(3)
  fee_calculation_basis   String?
  fee_approved_by_ref_id  String?         @db.Uuid
  fee_approved_at         DateTime?       @db.Timestamptz(6)
  payment_status          PaymentStatus   @default(pending_invoice)
  invoice_number          String?         @db.VarChar(100)
  invoice_sent_at         DateTime?       @db.Date
  invoice_due_at          DateTime?       @db.Date
  paid_amount             Decimal         @default(0) @db.Decimal(15, 4)
  paid_at                 DateTime?       @db.Date
  dispute_reason          String?
  notes                   String?
  created_by_ref_id       String          @db.Uuid
  deleted_at              DateTime?       @db.Timestamptz(6)
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime        @updatedAt @db.Timestamptz(6)

  offer            Offer              @relation(fields: [offer_id], references: [id], onDelete: NoAction)
  application      Application        @relation(fields: [application_id], references: [id], onDelete: NoAction)
  candidate        Candidate          @relation(fields: [candidate_id], references: [id], onDelete: NoAction)
  job              Job                @relation(fields: [job_id], references: [id], onDelete: NoAction)
  organization     Organization       @relation(fields: [organization_id], references: [id], onDelete: NoAction)
  placement_credit IdentityReference? @relation("PlacementCredit", fields: [placement_credit_ref_id], references: [id], onDelete: NoAction)
  secondary_credit IdentityReference? @relation("PlacementSecondaryCredit", fields: [secondary_credit_ref_id], references: [id], onDelete: NoAction)
  commercial_terms CommercialTerms?   @relation(fields: [commercial_terms_id], references: [id], onDelete: NoAction)
  fee_approved_by  IdentityReference? @relation("PlacementFeeApprovedBy", fields: [fee_approved_by_ref_id], references: [id], onDelete: NoAction)
  created_by       IdentityReference  @relation("PlacementCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)

  @@map("placements")
}

// -----------------------------------------------------------------------------
// Group 10 - Operational CRM
// -----------------------------------------------------------------------------

model RecruitmentNote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type   JobsEntityType
  entity_id     String         @db.Uuid
  content       String
  is_pinned     Boolean        @default(false)
  visibility    NoteVisibility @default(team)
  author_ref_id String         @db.Uuid
  deleted_at    DateTime?      @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  author IdentityReference @relation("RecruitmentNoteAuthor", fields: [author_ref_id], references: [id], onDelete: NoAction)

  @@index([entity_type, entity_id])
  @@map("recruitment_notes")
}

model Task {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_type           TaskType
  title               String          @db.VarChar(300)
  description         String?
  entity_type         JobsEntityType?
  entity_id           String?         @db.Uuid
  assigned_to_ref_id  String          @db.Uuid
  created_by_ref_id   String          @db.Uuid
  due_at              DateTime?       @db.Timestamptz(6)
  status              TaskStatus      @default(open)
  completed_at        DateTime?       @db.Timestamptz(6)
  completed_by_ref_id String?         @db.Uuid
  snoozed_until       DateTime?       @db.Timestamptz(6)
  priority            TaskPriority    @default(normal)
  deleted_at          DateTime?       @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)

  assigned_to  IdentityReference  @relation("TaskAssignedTo", fields: [assigned_to_ref_id], references: [id], onDelete: NoAction)
  created_by   IdentityReference  @relation("TaskCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)
  completed_by IdentityReference? @relation("TaskCompletedBy", fields: [completed_by_ref_id], references: [id], onDelete: NoAction)

  @@index([entity_type, entity_id])
  @@index([status, due_at])
  @@map("tasks")
}

model Communication {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communication_type CommunicationType
  direction          CommunicationDirection
  entity_type        CommunicationEntityType
  entity_id          String                  @db.Uuid
  subject            String?                 @db.VarChar(500)
  summary            String?
  logged_by_ref_id   String                  @db.Uuid
  occurred_at        DateTime                @db.Timestamptz(6)
  duration_minutes   Int?                    @db.SmallInt
  outcome            String?
  created_at         DateTime                @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                @updatedAt @db.Timestamptz(6)

  logged_by IdentityReference @relation("CommunicationLoggedBy", fields: [logged_by_ref_id], references: [id], onDelete: NoAction)

  @@index([entity_type, entity_id])
  @@map("communications")
}

// -----------------------------------------------------------------------------
// Group 11 - AI
// -----------------------------------------------------------------------------

model AIProcessingRun {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_type            AIRunType
  entity_type         String             @db.VarChar(50)
  entity_id           String             @db.Uuid
  model_provider      String             @db.VarChar(100)
  model_name          String             @db.VarChar(100)
  model_version       String             @db.VarChar(100)
  status              AIProcessingStatus @default(pending)
  started_at          DateTime?          @db.Timestamptz(6)
  completed_at        DateTime?          @db.Timestamptz(6)
  duration_ms         Int?
  input_tokens        Int?
  output_tokens       Int?
  error_detail        String?
  triggered_by_ref_id String?            @db.Uuid
  created_at          DateTime           @default(now()) @db.Timestamptz(6)

  triggered_by    IdentityReference? @relation("AIProcessingRunTriggeredBy", fields: [triggered_by_ref_id], references: [id], onDelete: NoAction)
  resume_versions ResumeVersion[]    @relation("ResumeVersionAIProcessingRun")
  extractions     AIExtraction[]
  scores          AIScore[]
  embeddings      EntityEmbedding[]

  @@index([entity_type, entity_id])
  @@map("ai_processing_runs")
}

model AIExtraction {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_processing_run_id         String    @db.Uuid
  resume_version_id            String    @db.Uuid
  candidate_id                 String    @db.Uuid
  field_path                   String    @db.VarChar(200)
  extracted_value              Json
  confidence_score             Decimal?  @db.Decimal(4, 3)
  is_applied                   Boolean   @default(false)
  applied_at                   DateTime? @db.Timestamptz(6)
  applied_by_ref_id            String?   @db.Uuid
  candidate_verified           Boolean   @default(false)
  candidate_verified_at        DateTime? @db.Timestamptz(6)
  recruiter_verified           Boolean   @default(false)
  recruiter_verified_at        DateTime? @db.Timestamptz(6)
  recruiter_verified_by_ref_id String?   @db.Uuid
  superseded_by_id             String?   @db.Uuid
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)

  ai_processing_run     AIProcessingRun    @relation(fields: [ai_processing_run_id], references: [id], onDelete: NoAction)
  resume_version        ResumeVersion      @relation(fields: [resume_version_id], references: [id], onDelete: NoAction)
  candidate             Candidate          @relation(fields: [candidate_id], references: [id], onDelete: NoAction)
  applied_by            IdentityReference? @relation("AIExtractionAppliedBy", fields: [applied_by_ref_id], references: [id], onDelete: NoAction)
  recruiter_verified_by IdentityReference? @relation("AIExtractionRecruiterVerifiedBy", fields: [recruiter_verified_by_ref_id], references: [id], onDelete: NoAction)
  superseded_by         AIExtraction?      @relation("AIExtractionSupersession", fields: [superseded_by_id], references: [id], onDelete: NoAction)
  supersedes            AIExtraction[]     @relation("AIExtractionSupersession")

  @@map("ai_extractions")
}

model AIScore {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_processing_run_id      String   @db.Uuid
  job_id                    String   @db.Uuid
  candidate_id              String   @db.Uuid
  application_id            String?  @db.Uuid
  overall_score             Decimal  @db.Decimal(5, 4)
  skill_match_score         Decimal? @db.Decimal(5, 4)
  domain_match_score        Decimal? @db.Decimal(5, 4)
  experience_match_score    Decimal? @db.Decimal(5, 4)
  semantic_similarity_score Decimal? @db.Decimal(5, 4)
  rank_in_job               Int?
  explanation_payload       Json?
  model_version             String   @db.VarChar(100)
  scored_at                 DateTime @db.Timestamptz(6)
  is_current                Boolean  @default(true)
  created_at                DateTime @default(now()) @db.Timestamptz(6)

  ai_processing_run AIProcessingRun @relation(fields: [ai_processing_run_id], references: [id], onDelete: NoAction)
  job               Job             @relation(fields: [job_id], references: [id], onDelete: NoAction)
  candidate         Candidate       @relation(fields: [candidate_id], references: [id], onDelete: NoAction)
  application       Application?    @relation(fields: [application_id], references: [id], onDelete: NoAction)

  @@map("ai_scores")
}

model EntityEmbedding {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type          EmbeddingEntityType
  entity_id            String                @db.Uuid
  embedding            Unsupported("vector")
  model_provider       String                @db.VarChar(100)
  model_name           String                @db.VarChar(200)
  model_version        String                @db.VarChar(100)
  dimension            Int
  ai_processing_run_id String?               @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)

  ai_processing_run AIProcessingRun? @relation(fields: [ai_processing_run_id], references: [id], onDelete: NoAction)

  // Migration 001 review: add pgvector HNSW index manually after provider setup.
  @@unique([entity_type, entity_id, model_name, model_version])
  @@map("entity_embeddings")
}

// -----------------------------------------------------------------------------
// Group 12 - Audit
// -----------------------------------------------------------------------------

model AuditEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type     String         @db.VarChar(50)
  entity_id       String         @db.Uuid
  action          String         @db.VarChar(100)
  actor_ref_id    String?        @db.Uuid
  actor_type      AuditActorType
  changed_fields  String[]       @default([])
  previous_values Json?
  new_values      Json?
  context         Json?
  ip_address      String?        @db.Inet
  user_agent      String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  actor IdentityReference? @relation("AuditEventActor", fields: [actor_ref_id], references: [id], onDelete: NoAction)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_ref_id, created_at])
  @@index([action, created_at])
  @@map("audit_events")
}
