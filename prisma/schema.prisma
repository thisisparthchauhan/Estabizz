model Job {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_code                String             @unique @db.VarChar(20)
  title                   String             @db.VarChar(300)
  slug                    String             @unique @db.VarChar(300)
  organization_id         String?            @db.Uuid
  client_contact_id       String?            @db.Uuid
  description             String
  internal_notes          String?
  status                  JobStatus          @default(draft)
  is_public               Boolean            @default(false)
  employment_type         JobEmploymentType?
  seniority_level         SeniorityLevel?
  min_years_experience    Int?
  max_years_experience    Int?
  salary_min              Decimal?           @db.Decimal(15, 4)
  salary_max              Decimal?           @db.Decimal(15, 4)
  salary_currency         String?            @db.VarChar(3)
  salary_disclosed        Boolean            @default(false)
  remote_policy           RemotePolicy?
  published_at            DateTime?          @db.Timestamptz(6)
  closes_at               DateTime?          @db.Date
  positions_count         Int                @default(1) @db.SmallInt
  positions_filled        Int                @default(0) @db.SmallInt
  priority                Priority           @default(normal)
  department              String?            @db.VarChar(100)
  location_text           String?            @db.VarChar(300)
  created_by_ref_id       String             @db.Uuid
  structured_requirements Json?
  approved_by_ref_id      String?            @db.Uuid
  approved_at             DateTime?          @db.Timestamptz(6)
  deleted_at              DateTime?          @db.Timestamptz(6)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @updatedAt @db.Timestamptz(6)

  organization     Organization?      @relation(fields: [organization_id], references: [id], onDelete: NoAction)
  client_contact   ClientContact?     @relation(fields: [client_contact_id], references: [id], onDelete: NoAction)
  created_by       IdentityReference  @relation("JobCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)
  approved_by      IdentityReference? @relation("JobApprovedBy", fields: [approved_by_ref_id], references: [id], onDelete: NoAction)
  skills           JobSkill[]
  domains          JobDomain[]
  locations        JobLocation[]
  questions        JobQuestion[]
  assignments      JobAssignment[]
  status_histories JobStatusHistory[]
  applications     Application[]
  placements       Placement[]
  ai_scores        AIScore[]

  @@index([status, is_public])
  @@index([organization_id, status])
  // GIN / pg_trgm indexes created by raw SQL in 20260820124028_init_jobs_schema.
  @@index([structured_requirements(ops: JsonbOps)], type: Gin, map: "jobs_structured_requirements_gin_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_title_trgm_idx")
  @@map("jobs")
}

