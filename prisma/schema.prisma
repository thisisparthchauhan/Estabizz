// Estabizz Jobs Prisma schema foundation.
// Source of truth: docs/jobs/05-ARCHITECTURE-FREEZE.md, with logical fields from
// docs/jobs/03-DATABASE-ERD.md.
//
// Migration 001 has intentionally NOT been created. Review this schema against
// the frozen ERD before generating or applying any database migration.

// -----------------------------------------------------------------------------
// GIN / pg_trgm index drift guard  (added 2026-09-10)
// -----------------------------------------------------------------------------
// 20260820124028_init_jobs_schema creates 12 GIN / pg_trgm indexes via raw SQL.
// Until they were declared here, every `prisma migrate dev` run read them as
// drift and emitted DROP INDEX for all 12 -- which, if ever applied, silently
// degrades the `contains` + mode: "insensitive" search filters on the
// candidates / applications / interviews admin lists to sequential scans.
//
// All 12 are now declared on Candidate, Job and Skill as
// `@@index([...], type: Gin, map: "<original index name>")`, so Migrate treats
// them as already present. There is NO residual drift: `prisma migrate diff
// --from-config-datasource --to-schema prisma/schema.prisma` is empty.
//
// DO NOT delete those @@index lines -- removing one reintroduces the DROP.
// The `postgresqlExtensions` preview feature is deliberately NOT enabled: it is
// not needed for `ops: raw("gin_trgm_ops")`, and the extension itself is created
// by the init migration (`CREATE EXTENSION IF NOT EXISTS pg_trgm`).
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

