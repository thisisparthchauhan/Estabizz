  previous_histories ApplicationStageHistory[]    @relation("ApplicationPreviousStage")
  new_histories      ApplicationStageHistory[]    @relation("ApplicationNewStage")

  @@map("application_stages")
}

model ApplicationStageTransition {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
