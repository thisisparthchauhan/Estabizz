# Estabizz local environment example.
# Copy values into .env.local locally, or configure them in Vercel/GitHub
# environment settings. Do not commit real secrets.

# Environment boundary: development | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing site/auth/CMS
MONGODB_URI=
# Signs the resume upload reference. Falls back to JWT_SECRET when unset, but a
# dedicated value keeps upload references and session tokens independent.
JOBS_RESUME_UPLOAD_TOKEN_SECRET=
JWT_SECRET=

# Public media only. This legacy unsigned Cloudinary upload path is for CMS/blog
# media and must not be used for future Jobs candidate CVs or documents.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Public lead forms
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=
NEXT_PUBLIC_FORMSPREE_COUNTRY_FORM_ID=

# Public API rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional existing integrations
ANTHROPIC_API_KEY=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_OWNER=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=
GITHUB_BACKUP_PATH=

# Jobs PostgreSQL + Prisma. Use only development/staging database URLs until the
# schema has been reviewed and Migration 001 is explicitly approved.
DATABASE_URL=

# Future Jobs infrastructure. Do not point staging values at production systems.
# These are placeholders for later phases; QStash/object storage/AI are not
# initialized in Phase 1A Part 2.
JOBS_OBJECT_STORAGE_PROVIDER=
JOBS_OBJECT_STORAGE_ENDPOINT=
JOBS_OBJECT_STORAGE_BUCKET=
JOBS_OBJECT_STORAGE_REGION=
JOBS_OBJECT_STORAGE_ACCESS_KEY_ID=
JOBS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
JOBS_OBJECT_STORAGE_FORCE_PATH_STYLE=false
JOBS_DOCUMENT_MAX_UPLOAD_MB=10
JOBS_DOCUMENT_PRESIGNED_UPLOAD_TTL_SECONDS=600
JOBS_DOCUMENT_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
JOBS_DOCUMENT_TEMP_TTL_MINUTES=60
# No malware scanner exists in this system. Uploads are recorded as
# not_scanned, which is a statement of fact and NOT a pass.
#   true  -> nothing is processed until a real scanner is integrated
#   false -> the operator KNOWINGLY accepts processing unscanned files
# Structural validation (lib/jobs/fileSecurity) always runs and is not a
# substitute for malware scanning.
JOBS_DOCUMENT_MALWARE_SCAN_REQUIRED=false

# Malware scanning (Phase 6). Structural validation is NOT antivirus.
# Provider is deliberately limited to a self-hosted scanner: commercial APIs
# would mean sending candidate documents to a third party.
#   provider  : "clamav" (only supported value) or empty for none
#   PRODUCTION: required=true is forced in code and cannot be disabled by env.
# With scanning required and no scanner configured, resumes are NOT processed.
# ClamAV runs as a Render PRIVATE service with no public URL, so Vercel cannot
# call it directly. Scans are routed through jobs-ai, which is already on
# Render's private network and already authenticated -- so the endpoint and
# secret below come from JOBS_AI_SERVICE_URL / AI_SERVICE_SECRET, and Vercel
# never needs the private hostname or the scanner's own secret.
#
# JOBS_MALWARE_SCANNER_URL / _SECRET are NOT set on Vercel. They belong on the
# Render services (see render.yaml).
JOBS_MALWARE_SCANNER_PROVIDER=
JOBS_MALWARE_SCANNER_TIMEOUT_MS=30000

# Temporary upload orphan reaper (Phase 6).
# Sweeps unconfirmed presigned uploads from tmp/candidates/. Objects referenced
# by a ResumeVersion are never touched, and a 30-minute floor applies whatever
# JOBS_DOCUMENT_TEMP_TTL_MINUTES says.
#   JOBS_DOCUMENT_CLEANUP_ENABLED: must be exactly "true" to actually delete;
#   anything else runs the sweep in dry-run and reports what it would remove.
JOBS_DOCUMENT_CLEANUP_ENABLED=false
JOBS_DOCUMENT_CLEANUP_MAX_DELETIONS=200
JOBS_DOCUMENT_CLEANUP_MAX_SCANNED=2000
JOBS_EMAIL_PROVIDER=resend
JOBS_EMAIL_FROM=
JOBS_EMAIL_REPLY_TO=
JOBS_EMAIL_STAGING_ALLOWLIST=
JOBS_EMAIL_STAGING_MODE=reject
JOBS_EMAIL_STAGING_REDIRECT_TO=
JOBS_EMAIL_PRODUCTION_DELIVERY_ENABLED=false
JOBS_EMAIL_SMOKE_TEST_TO=
JOBS_QUEUE_PROVIDER=qstash
JOBS_QUEUE_BASE_URL=
JOBS_QUEUE_DEFAULT_RETRIES=3
JOBS_QUEUE_RETRY_DELAY_EXPRESSION=1000 * pow(2, retried)
JOBS_QUEUE_MAX_PAYLOAD_BYTES=65536
JOBS_QUEUE_SMOKE_TEST_ENABLED=false
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
VERCEL_AUTOMATION_BYPASS_SECRET=
JOBS_AI_ENABLED=false
JOBS_AI_SERVICE_URL=
AI_SERVICE_SECRET=
JOBS_AI_PROVIDER=openai
JOBS_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Per-call caller timeouts (ms). Each MUST exceed the AI service's own
# ceiling for that operation plus network overhead. Service ceilings live in
# render.yaml: JOBS_AI_TEXT_EXTRACTION_TIMEOUT_SECONDS=30 and
# JOBS_AI_EXTRACTION_TIMEOUT_SECONDS=60. Replaces the old single
# JOBS_AI_REQUEST_TIMEOUT_MS, whose 30s ceiling sat below the 60s the service
# was allowed to spend.
JOBS_AI_HEALTH_TIMEOUT_MS=10000
JOBS_AI_TEXT_EXTRACTION_TIMEOUT_MS=45000
JOBS_AI_STRUCTURED_EXTRACTION_TIMEOUT_MS=75000
# Service-side ceilings, consumed by services/jobs-ai (see render.yaml).
JOBS_AI_TEXT_EXTRACTION_TIMEOUT_SECONDS=30
JOBS_AI_EXTRACTION_TIMEOUT_SECONDS=60
