}

model ApplicationStageHistory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id    String   @db.Uuid
  previous_stage_id String?  @db.Uuid
  new_stage_id      String   @db.Uuid
  changed_by_ref_id String   @db.Uuid
  changed_at        DateTime @db.Timestamptz(6)
  reason            String?
  notes             String?

  application    Application       @relation(fields: [application_id], references: [id], onDelete: NoAction)
