# Estabizz Jobs ClamAV scanner -- local / VPS deployment.
#
# Copy to `.env` and fill in. NAMES ONLY HERE: never commit a real value.
# `.env` is gitignored; `.env.example` is not.

# REQUIRED. Shared secret for the x-estabizz-scanner-secret header.
#
# Must be byte-identical to JOBS_MALWARE_SCANNER_SECRET on whatever calls this
# service (the jobs-ai bridge). Without it the service returns 503 to every
# scan rather than scanning unauthenticated.
#
# Generate one with:  openssl rand -hex 32
JOBS_MALWARE_SCANNER_SECRET=

# Must match JOBS_DOCUMENT_MAX_UPLOAD_MB on the application side, or the two
# ends disagree about which documents are too large.
JOBS_DOCUMENT_MAX_UPLOAD_MB=10
