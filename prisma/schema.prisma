// -----------------------------------------------------------------------------
// Group 1 - Identity
// -----------------------------------------------------------------------------

model IdentityReference {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_id         String       @db.VarChar(24)
  external_collection String       @db.VarChar(50)
  identity_type       IdentityType
  display_name_cache  String?      @db.VarChar(200)
  email_cache         String?      @db.VarChar(255)
  is_active_cache     Boolean      @default(true)
  last_synced_at      DateTime?    @db.Timestamptz(6)
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime     @updatedAt @db.Timestamptz(6)

  staff_capability                  StaffJobsCapability?      @relation("StaffCapabilityIdentity")
  granted_staff_capabilities        StaffJobsCapability[]     @relation("StaffCapabilityGrantedBy")
  candidate_identity                Candidate?                @relation("CandidateIdentity")
  candidates_primary_recruiter      Candidate[]               @relation("CandidatePrimaryRecruiter")
  candidates_assigned_recruiter     Candidate[]               @relation("CandidateAssignedRecruiter")
  candidates_created                Candidate[]               @relation("CandidateCreatedBy")
  candidates_last_contacted         Candidate[]               @relation("CandidateLastContactedBy")
  candidates_active_process_owner   Candidate[]               @relation("CandidateActiveProcessOwner")
  candidates_placement_credit       Candidate[]               @relation("CandidatePlacementCredit")
  candidates_deleted                Candidate[]               @relation("CandidateDeletedBy")
  resume_versions_uploaded          ResumeVersion[]           @relation("ResumeVersionUploadedBy")
  candidate_documents_uploaded      CandidateDocument[]       @relation("CandidateDocumentUploadedBy")
  tags_created                      Tag[]                     @relation("TagCreatedBy")
  candidate_tags_tagged             CandidateTag[]            @relation("CandidateTagTaggedBy")
  candidate_activities_actor        CandidateActivity[]       @relation("CandidateActivityActor")
  organizations_account_owner       Organization[]            @relation("OrganizationAccountOwner")
  organizations_account_manager     Organization[]            @relation("OrganizationAccountManager")
  organizations_created             Organization[]            @relation("OrganizationCreatedBy")
  client_contacts_created           ClientContact[]           @relation("ClientContactCreatedBy")
  commercial_terms_created          CommercialTerms[]         @relation("CommercialTermsCreatedBy")
  jobs_created                      Job[]                     @relation("JobCreatedBy")
  jobs_approved                     Job[]                     @relation("JobApprovedBy")
  job_assignments_recruiter         JobAssignment[]           @relation("JobAssignmentRecruiter")
  job_assignments_assigned_by       JobAssignment[]           @relation("JobAssignmentAssignedBy")
  job_status_histories_changed      JobStatusHistory[]        @relation("JobStatusChangedBy")
  applications_assigned_recruiter   Application[]             @relation("ApplicationAssignedRecruiter")
  applications_created              Application[]             @relation("ApplicationCreatedBy")
  applications_rejected             Application[]             @relation("ApplicationRejectedBy")
  application_stage_histories       ApplicationStageHistory[] @relation("ApplicationStageChangedBy")
  interviews_created                Interview[]               @relation("InterviewCreatedBy")
  interviews_feedback_submitted     Interview[]               @relation("InterviewFeedbackSubmittedBy")
  interview_participants_identity   InterviewParticipant[]    @relation("InterviewParticipantIdentity")
  offers_created                    Offer[]                   @relation("OfferCreatedBy")
  placements_credit                 Placement[]               @relation("PlacementCredit")
  placements_secondary_credit       Placement[]               @relation("PlacementSecondaryCredit")
  placements_fee_approved           Placement[]               @relation("PlacementFeeApprovedBy")
  placements_created                Placement[]               @relation("PlacementCreatedBy")
  recruitment_notes_authored        RecruitmentNote[]         @relation("RecruitmentNoteAuthor")
  tasks_assigned                    Task[]                    @relation("TaskAssignedTo")
  tasks_created                     Task[]                    @relation("TaskCreatedBy")
  tasks_completed                   Task[]                    @relation("TaskCompletedBy")
  communications_logged             Communication[]           @relation("CommunicationLoggedBy")
  ai_runs_triggered                 AIProcessingRun[]         @relation("AIProcessingRunTriggeredBy")
  ai_extractions_applied            AIExtraction[]            @relation("AIExtractionAppliedBy")
  ai_extractions_recruiter_verified AIExtraction[]            @relation("AIExtractionRecruiterVerifiedBy")
  audit_events_actor                AuditEvent[]              @relation("AuditEventActor")

  @@unique([external_collection, external_id])
  @@map("identity_references")
}

model StaffJobsCapability {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity_ref_id   String    @unique @db.Uuid
  role_template     String?   @db.VarChar(50)
  grants            Json      @default("[]")
  granted_by_ref_id String?   @db.Uuid
  granted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  identity   IdentityReference  @relation("StaffCapabilityIdentity", fields: [identity_ref_id], references: [id], onDelete: NoAction)
  granted_by IdentityReference? @relation("StaffCapabilityGrantedBy", fields: [granted_by_ref_id], references: [id], onDelete: NoAction)

  @@map("staff_jobs_capabilities")
}

// -----------------------------------------------------------------------------
// Group 2 - Candidate Core
// -----------------------------------------------------------------------------

model Candidate {
  id                          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity_ref_id             String?              @unique @db.Uuid
  candidate_code              String               @unique @db.VarChar(20)
  status                      CandidateStatus
  source                      CandidateSource
  source_detail               String?
  first_name                  String               @db.VarChar(100)
  last_name                   String               @db.VarChar(100)
  preferred_name              String?              @db.VarChar(100)
  date_of_birth               DateTime?            @db.Date
  gender                      String?              @db.VarChar(50)
  nationality                 String?              @db.VarChar(2)
  current_country             String?              @db.VarChar(2)
  current_state               String?              @db.VarChar(100)
  current_city                String?              @db.VarChar(100)
  current_postal_code         String?              @db.VarChar(20)
  current_title               String?              @db.VarChar(200)
  current_employer            String?              @db.VarChar(200)
  years_of_experience         Int?
  current_salary_amount       Decimal?             @db.Decimal(15, 4)
  current_salary_currency     String?              @db.VarChar(3)
  current_total_comp_amount   Decimal?             @db.Decimal(15, 4)
  current_total_comp_currency String?              @db.VarChar(3)
  notice_period_days          Int?
  available_from              DateTime?            @db.Date
  work_authorization          String?              @db.VarChar(50)
  remote_preference           WorkPreference?
  current_resume_version_id   String?              @db.Uuid
  portal_registered           Boolean              @default(false)
  profile_completeness_pct    Int                  @default(0) @db.SmallInt
  primary_recruiter_ref_id    String?              @db.Uuid
  assigned_recruiter_ref_id   String?              @db.Uuid
  assigned_team_id            String?              @db.Uuid
  created_by_ref_id           String               @db.Uuid
  last_contacted_by_ref_id    String?              @db.Uuid
  last_contacted_at           DateTime?            @db.Timestamptz(6)
  active_process_owner_ref_id String?              @db.Uuid
  placement_credit_ref_id     String?              @db.Uuid
  dedup_status                CandidateDedupStatus @default(unique)
  is_duplicate_of_id          String?              @db.Uuid
  internal_rating             Int?                 @db.SmallInt
  pref_job_types              String[]             @default([])
  pref_remote                 WorkPreference?
  pref_countries              String[]             @default([])
  pref_cities                 String[]             @default([])
  expected_salary_min         Decimal?             @db.Decimal(15, 4)
  expected_salary_max         Decimal?             @db.Decimal(15, 4)
  expected_salary_currency    String?              @db.VarChar(3)
  open_to_relocation          Boolean?
  open_to_international       Boolean?
  target_industries           String[]             @default([])
  target_seniority            String[]             @default([])
  preference_notes            String?
  deleted_at                  DateTime?            @db.Timestamptz(6)
  deleted_by_ref_id           String?              @db.Uuid
  deleted_reason              String?
  created_at                  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime             @updatedAt @db.Timestamptz(6)

  identity_ref         IdentityReference? @relation("CandidateIdentity", fields: [identity_ref_id], references: [id], onDelete: NoAction)
  current_resume       ResumeVersion?     @relation("CandidateCurrentResume", fields: [current_resume_version_id], references: [id], onDelete: NoAction)
  primary_recruiter    IdentityReference? @relation("CandidatePrimaryRecruiter", fields: [primary_recruiter_ref_id], references: [id], onDelete: NoAction)
  assigned_recruiter   IdentityReference? @relation("CandidateAssignedRecruiter", fields: [assigned_recruiter_ref_id], references: [id], onDelete: NoAction)
  created_by           IdentityReference  @relation("CandidateCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)
  last_contacted_by    IdentityReference? @relation("CandidateLastContactedBy", fields: [last_contacted_by_ref_id], references: [id], onDelete: NoAction)
  active_process_owner IdentityReference? @relation("CandidateActiveProcessOwner", fields: [active_process_owner_ref_id], references: [id], onDelete: NoAction)
  placement_credit     IdentityReference? @relation("CandidatePlacementCredit", fields: [placement_credit_ref_id], references: [id], onDelete: NoAction)
  duplicate_of         Candidate?         @relation("CandidateDuplicate", fields: [is_duplicate_of_id], references: [id], onDelete: NoAction)
  deleted_by           IdentityReference? @relation("CandidateDeletedBy", fields: [deleted_by_ref_id], references: [id], onDelete: NoAction)

  duplicates         Candidate[]                 @relation("CandidateDuplicate")
  contacts           CandidateContact[]
  consents           CandidateConsent[]
  employments        CandidateEmployment[]
  educations         CandidateEducation[]
  certifications     CandidateCertification[]
  skills             CandidateSkill[]
  domain_experiences CandidateDomainExperience[]
  resume_versions    ResumeVersion[]             @relation("CandidateResumeVersions")
  documents          CandidateDocument[]
  tags               CandidateTag[]
  activities         CandidateActivity[]
  applications       Application[]
  placements         Placement[]
  ai_extractions     AIExtraction[]
  ai_scores          AIScore[]

  @@index([status, created_at])
  @@index([current_country, current_city])
  @@index([primary_recruiter_ref_id])
  @@index([dedup_status])
  @@index([created_at])
  @@index([current_city, created_at])
  // GIN / pg_trgm indexes created by raw SQL in 20260820124028_init_jobs_schema.
  // Declared here so Migrate sees them as present instead of proposing DROP INDEX.
  @@index([first_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidates_first_name_trgm_idx")
  @@index([last_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidates_last_name_trgm_idx")
  @@index([current_title(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidates_current_title_trgm_idx")
  @@index([current_employer(ops: raw("gin_trgm_ops"))], type: Gin, map: "candidates_current_employer_trgm_idx")
  @@index([pref_job_types(ops: ArrayOps)], type: Gin, map: "candidates_pref_job_types_gin_idx")
  @@index([pref_countries(ops: ArrayOps)], type: Gin, map: "candidates_pref_countries_gin_idx")
  @@index([pref_cities(ops: ArrayOps)], type: Gin, map: "candidates_pref_cities_gin_idx")
  @@index([target_industries(ops: ArrayOps)], type: Gin, map: "candidates_target_industries_gin_idx")
  @@index([target_seniority(ops: ArrayOps)], type: Gin, map: "candidates_target_seniority_gin_idx")
  @@map("candidates")
}

model CandidateContact {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id       String               @db.Uuid
  contact_type       CandidateContactType
  value              String               @db.VarChar(500)
  phone_country_code String?              @db.VarChar(5)
  is_primary         Boolean              @default(false)
  is_verified        Boolean              @default(false)
  verified_at        DateTime?            @db.Timestamptz(6)
  opt_out            Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @updatedAt @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)

  @@unique([candidate_id, contact_type, value])
  @@map("candidate_contacts")
}

model CandidateConsent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id String       @db.Uuid
  consent_type ConsentType
  event        ConsentEvent
  ip_address   String?      @db.Inet
  user_agent   String?
  source       String?      @db.VarChar(100)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)

  @@index([candidate_id, consent_type, created_at])
  @@map("candidate_consents")
}

// -----------------------------------------------------------------------------
// Group 3 - Candidate Profile
// -----------------------------------------------------------------------------

model CandidateEmployment {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id     String          @db.Uuid
  employer_name    String          @db.VarChar(300)
  employer_country String?         @db.VarChar(2)
  title            String          @db.VarChar(200)
  employment_type  EmploymentType?
  start_date       DateTime        @db.Date
  end_date         DateTime?       @db.Date
  is_current       Boolean         @default(false)
  description      String?
  location_city    String?         @db.VarChar(100)
  location_country String?         @db.VarChar(2)
  salary_amount    Decimal?        @db.Decimal(15, 4)
  salary_currency  String?         @db.VarChar(3)
  ai_extracted     Boolean         @default(false)
  sort_order       Int             @default(0)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)

  @@map("candidate_employments")
}

model CandidateEducation {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id        String   @db.Uuid
  institution_name    String   @db.VarChar(300)
  institution_country String?  @db.VarChar(2)
  degree              String?  @db.VarChar(200)
  field_of_study      String?  @db.VarChar(200)
  start_year          Int?     @db.SmallInt
  end_year            Int?     @db.SmallInt
  grade               String?  @db.VarChar(50)
  ai_extracted        Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)

  @@map("candidate_educations")
}

model CandidateCertification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id       String    @db.Uuid
  certification_name String    @db.VarChar(200)
  issuing_body       String?   @db.VarChar(200)
  issued_date        DateTime? @db.Date
  expiry_date        DateTime? @db.Date
  license_number     String?   @db.VarChar(100)
  is_active          Boolean   @default(true)
  country            String?   @db.VarChar(2)
  ai_extracted       Boolean   @default(false)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)

  @@map("candidate_certifications")
}

model Skill {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(200)
  slug       String   @unique @db.VarChar(200)
  category   String?  @db.VarChar(100)
  aliases    String[] @default([])
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  candidate_skills CandidateSkill[]
  job_skills       JobSkill[]

  // GIN index created by raw SQL in 20260820124028_init_jobs_schema.
  @@index([aliases(ops: ArrayOps)], type: Gin, map: "skills_aliases_gin_idx")
  @@map("skills")
}

model CandidateSkill {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id     String            @db.Uuid
  skill_id         String            @db.Uuid
  proficiency      SkillProficiency?
  years_experience Decimal?          @db.Decimal(4, 1)
  is_primary       Boolean           @default(false)
  ai_extracted     Boolean           @default(false)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction)
  skill     Skill     @relation(fields: [skill_id], references: [id], onDelete: NoAction)

  @@unique([candidate_id, skill_id])
  @@map("candidate_skills")
}

model Domain {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @unique @db.VarChar(200)
  slug             String   @unique @db.VarChar(200)
  regulator        String?  @db.VarChar(100)
  sector           String?  @db.VarChar(100)
  parent_domain_id String?  @db.Uuid
  description      String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  parent_domain     Domain?                     @relation("DomainHierarchy", fields: [parent_domain_id], references: [id], onDelete: NoAction)
  child_domains     Domain[]                    @relation("DomainHierarchy")
  candidate_domains CandidateDomainExperience[]
  job_domains       JobDomain[]

  @@map("domains")
}

model CandidateDomainExperience {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id     String             @db.Uuid
  domain_id        String             @db.Uuid
  years_experience Decimal?           @db.Decimal(4, 1)
  proficiency      DomainProficiency?
  notes            String?
