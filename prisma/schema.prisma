  to_stage   ApplicationStage @relation("TransitionToStage", fields: [to_stage_id], references: [id], onDelete: NoAction)

  @@unique([from_stage_id, to_stage_id])
  @@map("application_stage_transitions")
}

model Application {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id                    String            @db.Uuid
  candidate_id              String            @db.Uuid
  snapshot_id               String?           @db.Uuid
  current_stage_id          String            @db.Uuid
  source                    ApplicationSource
  resume_version_id         String?           @db.Uuid
  assigned_recruiter_ref_id String?           @db.Uuid
  recruiter_notes           String?
  rejection_reason          RejectionReason?
  rejection_detail          String?
  rejected_by_ref_id        String?           @db.Uuid
  rejected_at               DateTime?         @db.Timestamptz(6)
  created_by_ref_id         String            @db.Uuid
  deleted_at                DateTime?         @db.Timestamptz(6)
  created_at                DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                DateTime          @updatedAt @db.Timestamptz(6)

  job                Job                       @relation(fields: [job_id], references: [id], onDelete: NoAction)
  candidate          Candidate                 @relation(fields: [candidate_id], references: [id], onDelete: NoAction)
  snapshot           ApplicationSnapshot?      @relation("ApplicationSelectedSnapshot", fields: [snapshot_id], references: [id], onDelete: NoAction)
  owned_snapshot     ApplicationSnapshot?      @relation("ApplicationSnapshotOwner")
  current_stage      ApplicationStage          @relation(fields: [current_stage_id], references: [id], onDelete: NoAction)
  resume_version     ResumeVersion?            @relation(fields: [resume_version_id], references: [id], onDelete: NoAction)
  assigned_recruiter IdentityReference?        @relation("ApplicationAssignedRecruiter", fields: [assigned_recruiter_ref_id], references: [id], onDelete: NoAction)
  rejected_by        IdentityReference?        @relation("ApplicationRejectedBy", fields: [rejected_by_ref_id], references: [id], onDelete: NoAction)
  created_by         IdentityReference         @relation("ApplicationCreatedBy", fields: [created_by_ref_id], references: [id], onDelete: NoAction)
  answers            ApplicationAnswer[]
  stage_histories    ApplicationStageHistory[]
  interviews         Interview[]
  offers             Offer[]
  placements         Placement[]
  ai_scores          AIScore[]

  @@index([created_at])
  @@index([current_stage_id, created_at])
  @@index([candidate_id, created_at])
  @@map("applications")
}

model ApplicationSnapshot {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id          String   @unique @db.Uuid
  candidate_id            String   @db.Uuid
  captured_at             DateTime @db.Timestamptz(6)
  first_name              String   @db.VarChar(100)
  last_name               String   @db.VarChar(100)
  current_title           String?  @db.VarChar(200)
  current_employer        String?  @db.VarChar(200)
  years_of_experience     Int?
  current_salary_amount   Decimal? @db.Decimal(15, 4)
  current_salary_currency String?  @db.VarChar(3)
