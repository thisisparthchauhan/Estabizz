  new_stage      ApplicationStage  @relation("ApplicationNewStage", fields: [new_stage_id], references: [id], onDelete: NoAction)
  changed_by     IdentityReference @relation("ApplicationStageChangedBy", fields: [changed_by_ref_id], references: [id], onDelete: NoAction)

  @@index([application_id, changed_at])
  @@map("application_stage_histories")
}

